# Deploy OpenRouter: preencha ambos. Não envie a chave ao GitHub.
# OPENROUTER_MODEL deve ser o ID exato do catálogo (fabricante/modelo).
# Se um destes campos estiver preenchido, este perfil tem prioridade sobre CREWAI_*.
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
# As configurações abaixo preservam a alternativa local anterior.
# Copie para .env; mantenha segredos somente no seu computador.
CREWAI_LLM=ollama/qwen3:4b-instruct-oxicor-cpu
CREWAI_BASE_URL=http://host.docker.internal:11434
CREWAI_API_KEY=ollama
OXICOR_RAG_BACKEND=local
OXICOR_DATA_DIR=/app/data
OXICOR_OBSERVABILITY_ENABLED=false
OXICOR_ADMIN_PAGES_ENABLED=false
OXICOR_RETENTION_DAYS=
OXICOR_EVAL_RESULT=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
OXICOR_LANGFUSE_ENABLED=false
# Opcionais: integração Flowise e relatórios PostgreSQL da etapa 1.
FLOWISE_API_URL=http://host.docker.internal:3000/api/v1/prediction/SEU_FLOW_ID
FLOWISE_API_KEY=
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=oxicor
POSTGRES_USER=
POSTGRES_PASSWORD=
