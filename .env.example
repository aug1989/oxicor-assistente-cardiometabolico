# Copie para .env; mantenha segredos somente no seu computador.
CREWAI_LLM=ollama/qwen3:4b-instruct-oxicor-cpu
CREWAI_BASE_URL=http://host.docker.internal:11434
CREWAI_API_KEY=ollama
OXICOR_RAG_BACKEND=local
CHAT_HISTORY_DB=/app/data/history.sqlite3
OXICOR_TRACE_DB=/app/data/observability.sqlite3
OXICOR_EVAL_RESULT=/app/data/evaluation/results.json
# Opcionais: integração Flowise e relatórios PostgreSQL da etapa 1.
FLOWISE_API_URL=http://host.docker.internal:3000/api/v1/prediction/SEU_FLOW_ID
FLOWISE_API_KEY=
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=oxicor
POSTGRES_USER=
POSTGRES_PASSWORD=
